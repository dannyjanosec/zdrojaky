void pohyb (int* r, int *c, int rows, int cols, int smer) {
 if (smer ==0) {
 *c = (*c+1)%cols;}
 else if (smer ==1) {
    *r = (*r+1)%rows; }
 else if (smer == 2){
    *c = (*c-1 + cols) % cols; }
else if (smer==3){
    *r = (*r-1 + rows) %rows;
}
}
