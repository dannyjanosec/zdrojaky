#include "drawing.h"
void cara(int delka)
{
  int i = 0;
  for (i = 0; i < delka; i++)
  {
    draw_pixel();
    move_right();
  }
}
void prerusovana_cara(int delka)
{
  int i = 0;
  for (i = 0; i < delka; i++)
  {
    draw_pixel();
    move_right();
    move_right();
  }
}
void schody(int pocet_schodu)
{
  int i = 0;
  for (i = 0; i < pocet_schodu; i++)
  {
    draw_pixel();
    move_right();
    move_down();
  }
}
void kvetina(int sirka, int vyska, int radek, int sloupec)
{
  set_red_color();
  move_to(radek, sloupec);
  prerusovana_cara(sirka);
  move_to(radek + 1, sloupec);
  cara(2 * sirka - 1);
  for (int index_radek = 2 + radek; index_radek < radek+vyska; index_radek++) 
  {
    move_to(index_radek, sloupec + (sirka-2/2));
    set_green_color();
    draw_pixel();
    move_down();
  }
  }
  void louka(int nahore, int dole) {
 int n = nahore;
 int d = dole;
    for (int pocet_nahore = 0; pocet_nahore < n; pocet_nahore++){
    kvetina(3,4,1, 10+(pocet_nahore*10));
    }
    for (int pocet_dole= 0; pocet_dole < d; pocet_dole++){ 
    kvetina (3 ,4, 6, 10+(pocet_dole*10));
   }
   }
